.DS_Store

go.sum
bin/**
coverage.out

.env

GODOC.md
LSP.md

CONTAINER.md
container-run.toml

# Ephemeral hook-generated files (should not be tracked)
.claude/session_summary.md
.claude/compact_backups/
.claude/deploy_backups/

# Ephemral research reports and retired docs
docs/reports/
docs/retired/
tmp/

# Tool folders are ignored except their tracked rules/ folders; Git cannot
# re-include a path under an excluded directory, so the `/*` form is required.
.claude/*
!.claude/rules/
.qoder/*
!.qoder/rules/
.codex/
.github/
.vscode/

.mcp.json
.codanna/
.codannaignore
# local folder
.fastembed_cache/
# link to global
.fastembed_cache

# Scaffold-owned setup: refreshed by the init script, never hand-edited.
*.scaffold
run_*.sh
.task/
